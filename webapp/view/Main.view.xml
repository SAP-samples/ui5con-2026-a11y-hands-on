
<mvc:View
	controllerName="com.sap.a11yworkshop.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:layout="sap.ui.layout"
	xmlns:core="sap.ui.core"
	core:require="{
		formatter: 'com/sap/a11yworkshop/model/formatter'
	}">

	<Page id="idMainPage" enableScrolling="true">

		<customHeader>
			<!-- ============================================================
				Custom page header. sap.m.Bar implements sap.m.IBar so it is
				a valid customHeader for sap.m.Page (unlike sap.f.ShellBar).
				============================================================ -->
			<Bar id="idHeader" design="Header">
				<contentLeft>
					<Title id="idAppTitle" text="IT Equipment Catalog"/>
					<Text text="Internal Procurement" class="sapUiTinyMarginBegin" />
				</contentLeft>
				<contentRight>
					<Button
						icon="sap-icon://bell"
						tooltip="Notifications (3 new)"
						type="Transparent" />
					<Button
						icon="sap-icon://cart"
						text="Orders"
						tooltip="Open orders"
						type="Transparent" />
					<Avatar initials="IP" backgroundColor="Accent6" displaySize="XS" />
				</contentRight>
			</Bar>
		</customHeader>

		<subHeader>
			<Bar id="idSubHeader" design="SubHeader">
				<contentLeft>
					<Breadcrumbs id="idCategoryBreadcrumbs" separatorStyle="Slash" maxDisplayedBreadcrumbs="4">
						<Link text="All Products" press=".onCategorySelect">
							<customData>
								<core:CustomData key="categoryKey" value="All" writeToDom="true" />
							</customData>
						</Link>
						<Link text="Laptops" press=".onCategorySelect">
							<customData>
								<core:CustomData key="categoryKey" value="Laptops" writeToDom="true" />
							</customData>
						</Link>
						<Link text="Monitors" press=".onCategorySelect">
							<customData>
								<core:CustomData key="categoryKey" value="Monitors" writeToDom="true" />
							</customData>
						</Link>
						<Link text="Peripherals" press=".onCategorySelect">
							<customData>
								<core:CustomData key="categoryKey" value="Peripherals" writeToDom="true" />
							</customData>
						</Link>
					</Breadcrumbs>
				</contentLeft>
			</Bar>
		</subHeader>

		<content>
			<!-- ============================================================

				Layout split: filter sidebar (260px) + main content (flex).
				Sits inside the Page's `content` aggregation, which is the
				<main> landmark.
				============================================================ -->
			<HBox id="idMainSplit" alignItems="Stretch" height="100%">
				<Panel
					id="idFilterPanel"
					headerText="Filters"
					expandable="false"
					class="workshop-filter-panel"
					width="260px">
					<content>
						<VBox class="sapUiMediumMarginBottom sapUiSmallMargin">
							<Title text="Brand" />
							<CheckBox text="Lenovo" selected="{catalog>/filters/brand/Lenovo}" select=".onFilterChange" />
							<CheckBox text="Dell" selected="{catalog>/filters/brand/Dell}" select=".onFilterChange" />
							<CheckBox text="Apple" selected="{catalog>/filters/brand/Apple}" select=".onFilterChange" />
							<CheckBox text="HP" selected="{catalog>/filters/brand/HP}" select=".onFilterChange" />
							<CheckBox text="Samsung" selected="{catalog>/filters/brand/Samsung}" select=".onFilterChange" />
						</VBox>
						<VBox class="sapUiMediumMarginBottom sapUiSmallMargin">
							<Title text="Price Range" />
							<CheckBox text="Under €100" selected="{catalog>/filters/price/under100}" select=".onFilterChange" />
							<CheckBox text="€100 – €500" selected="{catalog>/filters/price/100to500}" select=".onFilterChange" />
							<CheckBox text="€500 – €1,000" selected="{catalog>/filters/price/500to1000}" select=".onFilterChange" />
							<CheckBox text="Over €1,000" selected="{catalog>/filters/price/over1000}" select=".onFilterChange" />
						</VBox>
						<VBox class="sapUiSmallMargin">
							<Title text="Availability" />
							<CheckBox text="In Stock" selected="{catalog>/filters/stock/in}" select=".onFilterChange" />
							<CheckBox text="Out of Stock" selected="{catalog>/filters/stock/out}" select=".onFilterChange" />
						</VBox>
					</content>
				</Panel>

				<!-- ============================================================
					Main content — category tabs + sort toolbar + product grid
					============================================================ -->
				<VBox id="idMainContent" width="100%">
					<layoutData>
						<FlexItemData growFactor="1" minWidth="0" />
					</layoutData>

					<Panel
						id="idProductRegion"
						headerText="Product catalog"
						expandable="false">
						<content>
							<!-- Sort toolbar -->
							<OverflowToolbar>
								<Text text="{
									parts: ['catalog>/products', 'catalog>/selectedCategory'],
									formatter: 'formatter.productCountText',
									mode: 'OneWay'
								}" />
								<ToolbarSpacer />

								<Select id="idSortSelect" selectedKey="{catalog>/sortKey}" change=".onSortChange">
									<core:Item key="relevance" text="Relevance" />
									<core:Item key="price-asc" text="Price: Low to High" />
									<core:Item key="price-desc" text="Price: High to Low" />
									<core:Item key="rating" text="Rating" />
								</Select>
							</OverflowToolbar>

							<VBox id="idProductGrid" class="catalog-host"
								items="{
									path: 'catalog>/products',
									templateShareable: false
								}">
								<items>
									<HBox class="workshop-card">
										<VBox class="sapUiSmallMargin" width="100%">

											<Image
												src="{catalog>image}"
												decorative="false"
												densityAware="false"
												width="100%"
												height="180px"
												class="sapUiTinyMarginBottom" />

											<Title text="{catalog>name}" class="workshop-title-clamp sapUiTinyMarginBottom" />

											<Text text="{catalog>desc}" maxLines="2" class="sapUiTinyMarginBottom" />

											<ObjectStatus
												text="{= ${catalog>inStock} ? 'In stock' : 'Out of stock' }"
												state="{
													path: 'catalog>inStock',
													formatter: 'formatter.formatStockState'
												}"
												class="sapUiTinyMarginBottom" />

											<!-- Price block — sale price as H4 with strike-through old price -->
											<VBox class="sapUiTinyMarginBottom">
												<Title
													text="{
														parts: ['catalog>price', 'catalog>salePrice'],
														formatter: 'formatter.formatVisiblePrice'
													}"
													level="H4" />
												<Text
													visible="{= !!${catalog>salePrice} }"
													text="{
														parts: ['catalog>price', 'catalog>salePrice'],
														formatter: 'formatter.formatWasPrice'
													}"
													class="workshop-price-was" />
											</VBox>

											<!-- Footer row: wishlist/share + Order -->
											<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginTop">
												<HBox>

													<Button icon="sap-icon://heart" type="Transparent" press=".onWishlistPress" />
													<Button icon="sap-icon://share-2" type="Transparent" press=".onSharePress" />
												</HBox>

												<Button
													text="Order Now"
													type="Emphasized"
													icon="sap-icon://cart-3"
													press=".onOrderPress">
													<customData>
														<core:CustomData key="productId" value="{= '' + ${catalog>id} }" writeToDom="true" />
													</customData>
												</Button>
											</HBox>
										</VBox>
									</HBox>
								</items>
							</VBox>
					</content>
				</Panel>
				</VBox>
			</HBox>
		</content>
	</Page>

</mvc:View>
